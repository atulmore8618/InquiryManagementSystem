@model InquiryManagementSystem.ViewModels.InquiryListViewModel

@{
    ViewData["Title"] = "Inquiry Dashboard";
}

<div class="container mt-4">

    <h1 class="mb-4">Inquiry Management System</h1>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Inquiries</h6>
                    <h2>@Model.TotalCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Pending</h6>
                    <h2 class="text-warning">@Model.PendingCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Responded</h6>
                    <h2 class="text-success">@Model.RespondedCount</h2>
                </div>
            </div>
        </div>
    </div>

    <form asp-controller="Inquiries" asp-action="Index" method="get" class="row g-2 mb-3">

        <div class="col-md-5">
            <input type="text" name="search" value="@Model.Search"
                   class="form-control"
                   placeholder="Search customer, email, subject, vehicle..." />
        </div>

        <div class="col-md-3">
            <select name="status" class="form-select">
                @{
                    var statusOptions = new[] { "All", "New", "RateSubmitted", "Responded" };
                    var selectedStatus = Model.Status ?? "All";
                }
                @foreach (var s in statusOptions)
                {
                    if (s == selectedStatus)
                    {
                        <option value="@s" selected>@s</option>
                    }
                    else
                    {
                        <option value="@s">@s</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>

        <div class="col-md-2">
            <a asp-controller="Inquiries" asp-action="Index"
               class="btn btn-outline-secondary w-100">Reset</a>
        </div>

    </form>

    @if (!Model.Inquiries.Any())
    {
        <div class="alert alert-info">No inquiries found.</div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Email</th>
                    <th>Subject</th>
                    <th>Vehicle</th>
                    <th>Status</th>
                    <th>Received</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inquiry in Model.Inquiries)
                {
                    <tr>
                        <td>@inquiry.InquiryId</td>
                        <td>@inquiry.CustomerName</td>
                        <td>@inquiry.CustomerEmail</td>
                        <td>@inquiry.Subject</td>
                        <td>@inquiry.VehicleDetails</td>
                        <td>
                            @if (inquiry.Status == "Responded")
                            {
                                <span class="badge bg-success">Responded</span>
                            }
                            else if (inquiry.Status == "RateSubmitted")
                            {
                                <span class="badge bg-warning text-dark">RateSubmitted</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">@inquiry.Status</span>
                            }
                        </td>
                        <td>@inquiry.ReceivedAt.ToString("dd MMM HH:mm")</td>
                        <td>
                            <a asp-controller="Inquiries"
                               asp-action="Details"
                               asp-route-id="@inquiry.InquiryId"
                               class="btn btn-primary btn-sm">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>